# ---------- shared ----------
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# ---------- apps/api (resource server + clients) ----------
API_PORT=3333
WEB_ORIGIN=http://localhost:4200
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# access token lifetime for the Access+Refresh demo (seconds) - short on purpose
ACCESS_TOKEN_TTL=60
REFRESH_TOKEN_TTL=604800

# ---------- apps/auth-server (OAuth2 AS / OIDC OP / SAML IdP) ----------
AUTH_SERVER_PORT=4000
ISSUER=http://localhost:4000
# confidential client used by the API's OIDC BFF
OIDC_CLIENT_ID=authlab-bff
OIDC_CLIENT_SECRET=bff-secret-change-me
